# AlphaEdge AINV MCP Server Environment Configuration
# Copy this file to .env and fill in your values

# ===== NVIDIA API =====
# Get your API key from: https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-your-key-here

# ===== LM Studio =====
# Default: http://localhost:1234/v1
LM_STUDIO_URL=http://localhost:1234/v1
LM_STUDIO_TIMEOUT=120

# ===== Server Configuration =====
SERVER_PORT=8000
SERVER_HOST=localhost
DEBUG_MODE=false

# ===== Paths (Windows G: drive) =====
PROJECT_ROOT=G:\AlphaEdge_AINV
WORKSPACE_DIR=G:\AlphaEdge_AINV\workspace
LOG_FILE=G:\AlphaEdge_AINV\mcp_server.log

# ===== Safety Limits =====
MAX_FILE_SIZE_MB=10
COMMAND_TIMEOUT=30
PYTHON_MEMORY_LIMIT_GB=1

# ===== GPU Configuration =====
VRAM_WARNING_THRESHOLD=0.90
VRAM_CRITICAL_THRESHOLD=0.95
GPU_TEMP_WARNING=80
GPU_TEMP_CRITICAL=85

# ===== API Rate Limiting =====
NVIDIA_RATE_LIMIT=10
MAX_RETRIES=3
RETRY_DELAY_SECONDS=2
