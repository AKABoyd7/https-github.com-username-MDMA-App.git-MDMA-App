# AlphaEdge AINV - Environment Configuration Template
# Copyright © 2025 AlphaEdge AINV
# คัดลอกไฟล์นี้เป็น .env และกรอกค่าจริง: copy .env.example .env

# ============================================
# API Keys (จำเป็น!)
# ============================================

# NVIDIA API Key (สำหรับ Nemotron + NV-CLIP)
# รับได้ที่: https://build.nvidia.com/explore/discover
NVIDIA_API_KEY=nvapi-your-key-here

# Anthropic API Key (Optional - สำหรับ Claude)
# รับได้ที่: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ============================================
# LM Studio Configuration
# ============================================

# LM Studio Local Server URL
LM_STUDIO_URL=http://localhost:1234/v1

# LM Studio API Key (ถ้ามี - ปกติไม่ต้องใส่)
LM_STUDIO_API_KEY=

# ============================================
# CUDA & GPU Settings
# ============================================

# CUDA Device (0 = GPU แรก, 1 = GPU ที่สอง, cpu = ใช้ CPU)
CUDA_DEVICE=0

# Enable CUDA-X Acceleration
USE_TENSORRT=true
USE_RAPIDS=false
USE_MULTI_GPU=false

# TensorRT Precision (fp16, int8, fp32)
TENSORRT_PRECISION=fp16

# Multi-GPU Settings (ถ้าเปิด USE_MULTI_GPU=true)
CUDA_VISIBLE_DEVICES=0,1,2,3
NCCL_DEBUG=WARN
WORLD_SIZE=1
RANK=0

# ============================================
# Server Configuration
# ============================================

# API Server
API_HOST=0.0.0.0
API_PORT=8000

# WebSocket Server
WS_PORT=8001

# Gradio Web UI
GRADIO_HOST=0.0.0.0
GRADIO_PORT=7860
GRADIO_SHARE=false

# ============================================
# Model Paths & Cache
# ============================================

# Model Cache Directory
MODEL_CACHE_DIR=./models_cache

# Whisper Model Size (tiny, base, small, medium, large-v3)
WHISPER_MODEL_SIZE=large-v3

# Piper TTS Voice
PIPER_VOICE=en_US-lessac-medium

# OCR Language (en, th, ch)
OCR_LANG=en+th

# ============================================
# Vector Database (ChromaDB)
# ============================================

# ChromaDB Storage Path
CHROMA_PERSIST_DIR=./chroma_db

# Embedding Model
EMBEDDING_MODEL=nvidia/nv-clip-vit-h-14

# ============================================
# Performance Settings
# ============================================

# Max Concurrent Requests
MAX_CONCURRENT_REQUESTS=4

# Request Timeout (seconds)
REQUEST_TIMEOUT=300

# Batch Size
BATCH_SIZE=1

# Cache Settings
ENABLE_CACHE=true
CACHE_TTL=3600

# ============================================
# Logging
# ============================================

# Log Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Log Directory
LOG_DIR=./logs

# Log Format
LOG_FORMAT=[%(asctime)s] %(levelname)s - %(name)s - %(message)s

# ============================================
# Security Settings
# ============================================

# API Authentication (Optional)
API_KEY=
ENABLE_AUTH=false

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:7860

# ============================================
# Advanced Settings
# ============================================

# Development Mode
DEV_MODE=false

# Debug Mode
DEBUG=false

# Enable Telemetry
ENABLE_TELEMETRY=false

# Auto-reload on code changes
AUTO_RELOAD=false
